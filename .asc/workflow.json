{
  // Release automation. Run: asc workflow run ship-ios VERSION:x.y.z
  "env": { "IOS_APP_ID": "6782366555", "MAC_APP_ID": "6782661988", "VERSION": "", "SUBMIT": "true" },
  "before_all": "asc auth status",
  "workflows": {
    "ship-ios": { "description": "Bump, archive, upload, submit iOS", "steps": [
      { "name": "bump", "run": "cd ios && asc xcode version edit --version \"$VERSION\" --build-number \"$(date +%Y%m%d%H%M)\"" },
      { "name": "archive", "run": "cd ios && asc xcode archive --project Talli.xcodeproj --scheme Talli --archive-path ../.asc/artifacts/Talli.xcarchive --overwrite --xcodebuild-flag=-skipPackagePluginValidation --xcodebuild-flag=-allowProvisioningUpdates --output json" },
      { "name": "export", "run": "cd ios && asc xcode export --archive-path ../.asc/artifacts/Talli.xcarchive --export-options ExportOptions.plist --ipa-path ../.asc/artifacts/Talli.ipa --output json --xcodebuild-flag=-allowProvisioningUpdates" },
      { "name": "publish", "if": "SUBMIT", "run": "asc publish appstore --app $IOS_APP_ID --ipa .asc/artifacts/Talli.ipa --version $VERSION --wait --submit --confirm --output json" }
    ] },
    "ship-mac": { "description": "Bump, archive, upload, submit Mac", "steps": [
      { "name": "bump_mac", "run": "cd macos && asc xcode version edit --version \"$VERSION\" --build-number \"$(date +%Y%m%d%H%M)\"" },
      { "name": "archive_mac", "run": "cd macos && asc xcode archive --project TalliMac.xcodeproj --scheme TalliMac --archive-path ../.asc/artifacts/TalliMac-mac.xcarchive --overwrite --output json" },
      { "name": "export_mac", "run": "cd macos && asc xcode export --archive-path ../.asc/artifacts/TalliMac-mac.xcarchive --export-options ExportOptions.plist --overwrite --ipa-path ../.asc/artifacts/TalliMac-mac.ipa --output json" },
      { "name": "publish_mac", "if": "SUBMIT", "run": "asc publish appstore --app $MAC_APP_ID --ipa .asc/artifacts/TalliMac-mac.ipa --version $VERSION --wait --submit --confirm --output json" }
    ] }
  }
}
