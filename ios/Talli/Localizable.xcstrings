        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus beneficios. Sin burocracia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang iyong mga benepisyo. Walang abala."
