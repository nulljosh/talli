    "The filing window is open days 1–5 of each month. Submit during this window.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The filing window is open days 1–5 of each month. Submit during this window."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre de déclaration est ouverte du 1er au 5 de chaque mois. Soumettez durant cette période."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每月 1 至 5 日开放申报。请在此期间提交。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫਾਈਲਿੰਗ ਵਿੰਡੋ ਹਰ ਮਹੀਨੇ 1 ਤੋਂ 5 ਤਾਰੀਖ ਤੱਕ ਖੁੱਲ੍ਹੀ ਰਹਿੰਦੀ ਹੈ। ਇਸ ਸਮੇਂ ਦੌਰਾਨ ਜਮ੍ਹਾਂ ਕਰੋ।"
          }
        }
      }
    },
