    "Last known amount. 4 payments per year. Not all CRA credits shown.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last known amount. 4 payments per year. Not all CRA credits shown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernier montant connu. 4 paiements par an. Tous les crédits de l'ARC ne sont pas affichés."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次已知金额。每年付款 4 次。未显示所有 CRA 抵免。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਖਰੀ ਜਾਣੀ ਰਕਮ। ਸਾਲ ਵਿੱਚ 4 ਭੁਗਤਾਨ। ਸਾਰੇ CRA ਕ੍ਰੈਡਿਟ ਨਹੀਂ ਦਿਖਾਏ ਗਏ।"
          }
        }
      }
    },
